rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the current user is operating on their own document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Check if the current user has a profile in the doctors collection
    function isDoctor() {
      return isAuthenticated() && exists(/databases/$(database)/documents/doctors/$(request.auth.uid));
    }

    // Check if the current user is a doctor who is authorized to view this patient
    // We omit isDoctor() here because exists() in rules breaks the query planner for bulk queries.
    // The query where('authorizedDoctorIds', 'array-contains', uid) will perfectly match this.
    function doctorHasAccess(patientData) {
      return isAuthenticated() && (request.auth.uid in patientData.authorizedDoctorIds);
    }

    // Used for subcollections (reports, notes) where we need to fetch the parent patient doc
    function doctorHasAccessById(patientId) {
      let patientDoc = get(/databases/$(database)/documents/patients/$(patientId));
      return isAuthenticated() && (request.auth.uid in patientDoc.data.authorizedDoctorIds);
    }

    // ========================================================================
    // DOCTORS COLLECTION
    // Path: /doctors/{doctorId}
    // ========================================================================
    match /doctors/{doctorId} {
      // Anyone authenticated can view doctor profiles (so patients can see their doctor's name)
      allow read: if isAuthenticated();
      
      // Doctors can create and update their own profiles
      allow create, update: if isOwner(doctorId);
      
      // Deletion is restricted to prevent orphaned data
      allow delete: if false;
    }

    // ========================================================================
    // PATIENTS COLLECTION
    // Path: /patients/{patientId}
    // ========================================================================
    match /patients/{patientId} {
      // Patients can read their own profile. Doctors can read if authorized.
      allow read: if isOwner(patientId) || doctorHasAccess(resource.data);

      // Only Doctors can create a new patient account
      // They must include their own UID in the authorized list
      allow create: if isDoctor() && doctorHasAccess(request.resource.data);

      // Updates are allowed by the patient themselves (e.g. changing password/firstLogin flag)
      // OR by an authorized doctor (e.g. updating access lists)
      allow update: if isOwner(patientId) || doctorHasAccess(resource.data);

      // Deletion is restricted
      allow delete: if false;
    }

    // ========================================================================
    // REPORTS SUBCOLLECTION
    // Path: /patients/{patientId}/reports/{reportId}
    // ========================================================================
    match /patients/{patientId}/reports/{reportId} {
      // Both the patient and their authorized doctors can read the reports
      allow read: if isOwner(patientId) || doctorHasAccessById(patientId);

      // Only an authorized doctor can create a report for a patient
      // The analyzedBy field must match the doctor's UID
      allow create: if doctorHasAccessById(patientId) 
                    && request.resource.data.analyzedBy == request.auth.uid;

      // Only the doctor who originally analyzed the report can update it
      allow update: if isOwner(resource.data.analyzedBy);

      // Reports cannot be deleted
      allow delete: if false;
    }

    // ========================================================================
    // NOTES SUBCOLLECTION
    // Path: /patients/{patientId}/reports/{reportId}/notes/{noteId}
    // ========================================================================
    match /patients/{patientId}/reports/{reportId}/notes/{noteId} {
      // Reads:
      // Reads: Patient and authorized doctors can read notes.
      // (Visibility filtering is handled securely by the frontend query/UI to prevent query planner crashes)
      allow read: if isOwner(patientId) || doctorHasAccessById(patientId);

      // Creation: Only authorized doctors can create notes, and they must be the author.
      allow create: if doctorHasAccessById(patientId)
                    && request.resource.data.authorId == request.auth.uid;

      // Update/Delete: Only the original author can edit or delete their note.
      allow update, delete: if isOwner(resource.data.authorId);
    }

    // ========================================================================
    // DEFAULT DENY
    // ========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
